#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

resolve_hook_bin() {
  if [[ -n "${DETECT_SECRETS_HOOK_BIN:-}" && -x "${DETECT_SECRETS_HOOK_BIN}" ]]; then
    echo "${DETECT_SECRETS_HOOK_BIN}"
    return 0
  fi

  if command -v detect-secrets-hook >/dev/null 2>&1; then
    command -v detect-secrets-hook
    return 0
  fi

  if [[ -x "${REPO_ROOT}/.venv/bin/detect-secrets-hook" ]]; then
    echo "${REPO_ROOT}/.venv/bin/detect-secrets-hook"
    return 0
  fi

  if [[ -x "${REPO_ROOT}/../.venv/bin/detect-secrets-hook" ]]; then
    echo "${REPO_ROOT}/../.venv/bin/detect-secrets-hook"
    return 0
  fi

  return 1
}

staged_files=$(git diff --cached --name-only --diff-filter=ACM)
if [[ -z "${staged_files}" ]]; then
  exit 0
fi

while IFS= read -r file; do
  base="$(basename "$file")"
  if [[ "$base" == ".env" ]]; then
    echo "Blocked: .env file detected in staged changes."
    exit 1
  fi

  if [[ "$base" == .env.* && "$base" != ".env.example" ]]; then
    echo "Blocked: sensitive env file detected in staged changes: $base"
    exit 1
  fi
done <<< "${staged_files}"

if echo "${staged_files}" | rg -n 'vite\.config\.ts\.timestamp-.*\.mjs$' >/dev/null; then
  echo "Blocked: vite timestamp temp file detected in staged changes."
  exit 1
fi

if ! HOOK_BIN="$(resolve_hook_bin)"; then
  echo "Missing detect-secrets hook binary."
  echo "Install options:"
  echo "  1) python -m pip install detect-secrets"
  echo "  2) create ${REPO_ROOT}/.venv and install detect-secrets there"
  echo "  3) set DETECT_SECRETS_HOOK_BIN=/absolute/path/to/detect-secrets-hook"
  exit 1
fi

# Scan against a baseline when the repo has one. detect-secrets inspects whole
# staged files, not just the diff, so a single audited finding anywhere in a file
# — a localhost test DSN, say — would otherwise block every future commit that
# touches it. With a baseline, known findings are recorded and only NEW ones fail.
# Regenerate after auditing:  detect-secrets scan > .secrets.baseline
baseline_args=()
if [[ -f "${REPO_ROOT}/.secrets.baseline" ]]; then
  baseline_args=(--baseline "${REPO_ROOT}/.secrets.baseline")
fi

# The baseline records each finding as a SHA1 digest, which the scanner then
# reports as a high-entropy string — so scanning the baseline with itself can
# never pass. Exclude it; its contents are hashes, not secrets.
scan_files=$(printf '%s\n' "${staged_files}" | grep -v '^\.secrets\.baseline$' || true)
if [[ -z "${scan_files}" ]]; then
  exit 0
fi

# shellcheck disable=SC2086
"${HOOK_BIN}" ${baseline_args[@]+"${baseline_args[@]}"} ${scan_files}
